# Server-only configuration. Never commit a real .env file.
SILENTWINDOW_VERSION=1.1.0
HOST=127.0.0.1
PORT=8000
# Comma-separated browser origins; keep local by default.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional legacy Gemini chat integration.
# GEMINI_API_KEY=replace-with-a-new-gemini-api-key
# GEMINI_MODEL=gemini-2.0-flash

# Optional experimental Supabase persistence for ai.py (not required by default app).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# SUPABASE_ANON_KEY=...

# Optional Telegram notification integration.
# TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
# TELEGRAM_CHAT_ID=replace-with-chat-id
